---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { tools } from '../tools';
import { projects } from '../projects';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = allPosts.slice(0, 3);

const sections = [
  { href: '/blog', title: '写作', desc: '踩过的坑，和想明白的事。', count: allPosts.length, unit: '篇' },
  { href: '/projects', title: '作品', desc: '做过的东西，有的还在跑。', count: projects.length, unit: '个' },
  { href: '/tools', title: '工具', desc: '打开就能用，数据不上传。', count: tools.length, unit: '个' },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base>
  <section class="hero">
    <h1>{site.title}</h1>
    <p class="hero-lead">{site.tagline}</p>
    <p class="hero-sub">
      桌面上堆了一堆项目，都能跑，也都没人看见 —— 包括我自己。
      这里是它们的落脚点，顺便放些自己在用的小工具。
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/blog">读点东西 →</a>
      <a class="btn btn-ghost" href="/tools">看看工具</a>
    </div>
  </section>

  <ul class="cards">
    {
      sections.map((s) => (
        <li>
          <a class="card" href={s.href}>
            <div class="top">
              <h3>{s.title}</h3>
              <span class="count">{s.count} {s.unit}</span>
            </div>
            <p>{s.desc}</p>
            <span class="go">进入 →</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    recent.length > 0 && (
      <section>
        <div class="sec-head">
          <h2>最近写的</h2>
          <a href="/blog" class="more">全部 →</a>
        </div>
        <ul class="post-list">
          {recent.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <style>
    .hero { padding: 1.5rem 0 3rem; }
    .hero h1 { font-size: clamp(2.2rem, 5vw, 3rem); margin: 0 0 0.8rem; }
    .hero-lead { font-size: 1.15rem; margin: 0 0 0.8rem; }
    .hero-sub { font-size: 0.95rem; color: var(--text-muted); max-width: 52ch; margin: 0 0 2rem; }

    .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.6rem 1.2rem; border-radius: 8px;
      font-size: 0.92rem; text-decoration: none;
      border: 1px solid transparent; transition: 0.15s;
    }
    .btn-primary { background: var(--text); color: #fff; }
    .btn-primary:hover { background: #333; }
    .btn-ghost { background: #fff; color: var(--text); border-color: var(--border); }
    .btn-ghost:hover { border-color: var(--text-dim); }

    .top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
    .top h3 { margin: 0; }
    .count { font-size: 0.78rem; color: var(--text-dim); font-family: var(--mono); }

    .sec-head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 1rem; margin-top: 3.5rem;
      border-bottom: 1px solid var(--border); padding-bottom: 0.55rem;
    }
    .sec-head h2 { margin: 0; font-size: 1.2rem; }
    .more { font-size: 0.84rem; color: var(--text-muted); text-decoration: none; }
    .more:hover { color: var(--text); }
    .post-list { margin-top: 0.4rem; }
  </style>
</Base>
