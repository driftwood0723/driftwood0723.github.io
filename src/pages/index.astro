---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base>
  <h1>{site.title}</h1>
  <p class="lead">{site.tagline}</p>

  <p>
    这里放我写的东西、做过的项目，以及一些自己在用的小工具。
    大部分内容是给未来的自己看的，如果碰巧对你也有用，那更好。
  </p>

  {
    posts.length > 0 && (
      <>
        <h2>最近写的</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            </li>
          ))}
        </ul>
        <p style="margin-top:1.5rem"><a href="/blog">全部文章 →</a></p>
      </>
    )
  }
</Base>
