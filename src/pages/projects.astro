---
import Base from '../layouts/Base.astro';
import { projects } from '../projects';
---

<Base title="作品" description="做过的一些东西。" wide>
  <h1><span class="grad">作品</span></h1>
  <p class="lead">做过的一些东西，有的还在跑，有的已经停了。</p>

  <ul class="cards">
    {
      projects.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <li>
            <Tag class="card" href={p.href} target={p.href ? '_blank' : undefined} rel={p.href ? 'noopener' : undefined}>
              <h3>
                {p.name}
                {p.year && <span class="muted" style="font-weight:400;font-size:0.8rem;font-family:var(--mono)"> · {p.year}</span>}
              </h3>
              <p>{p.description}</p>
              <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</Base>
