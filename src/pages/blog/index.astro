---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base title="写作" description="踩过的坑和想明白的事。">
  <h1><span class="grad">写作</span></h1>
  <p class="lead">踩过的坑，和想明白的事。</p>

  {posts.length === 0 ? (
    <p class="muted">还没有文章。往 <code>src/content/blog/</code> 里丢一个 md 文件就行。</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.description && <p class="muted" style="margin:0.4rem 0 0;font-size:0.9rem">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
