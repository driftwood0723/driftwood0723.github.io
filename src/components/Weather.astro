---
/* 背景天气：Canvas 2D 粒子 + 景深分层（近大快、远小淡）
   切换器是临时的，定下来后可删，把默认 mode 写死即可 */
---

<canvas id="weather" aria-hidden="true"></canvas>

<div class="wswitch" role="group" aria-label="背景天气">
  <button data-mode="off">无</button>
  <button data-mode="rain">雨</button>
  <button data-mode="snow">雪</button>
</div>

<script>
  type Mode = 'off' | 'rain' | 'snow';

  const KEY = 'weather-mode';
  const canvas = document.getElementById('weather') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let mode: Mode = 'off';
  let raf = 0;
  let w = 0, h = 0, dpr = 1;
  let wind = 0;          // 风向缓慢漂移
  let particles: Particle[] = [];

  interface Particle {
    x: number; y: number;
    z: number;            // 深度 0(远)..1(近)
    v: number;            // 下落速度
    len: number;          // 雨：线长 / 雪：半径
    phase: number;        // 雪的摆动相位
    sway: number;         // 雪的摆动幅度
  }

  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth; h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (mode !== 'off') spawn();
  }

  function count() {
    const area = w * h;
    const base = mode === 'rain' ? 12000 : 18000;
    return Math.min(Math.round(area / base), mode === 'rain' ? 220 : 160);
  }

  function make(initial: boolean): Particle {
    const z = Math.random();
    return {
      x: Math.random() * w,
      y: initial ? Math.random() * h : -20 - Math.random() * 80,
      z,
      v: mode === 'rain'
        ? 520 + z * 780              // 雨速快，近处更快
        : 22 + z * 48,               // 雪缓慢
      len: mode === 'rain'
        ? 9 + z * 20                 // 线长
        : 0.8 + z * 2.2,             // 半径
      phase: Math.random() * Math.PI * 2,
      sway: 14 + Math.random() * 26,
    };
  }

  function spawn() {
    particles = Array.from({ length: count() }, () => make(true));
  }

  let last = performance.now();

  function frame(now: number) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;

    ctx.clearRect(0, 0, w, h);
    wind += dt * 0.12;
    const gust = Math.sin(wind) * (mode === 'rain' ? 0.35 : 0.5);

    for (const p of particles) {
      if (mode === 'rain') {
        const dx = gust * p.v * 0.22;
        p.x += dx * dt;
        p.y += p.v * dt;

        ctx.strokeStyle = `rgba(108,132,168,${0.12 + p.z * 0.3})`;
        ctx.lineWidth = 0.6 + p.z * 0.9;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(p.x - dx * 0.035, p.y + p.len);
        ctx.stroke();
      } else {
        p.phase += dt * 1.1;
        p.x += (Math.sin(p.phase) * p.sway + gust * 26) * dt;
        p.y += p.v * dt;

        ctx.fillStyle = `rgba(138,158,190,${0.2 + p.z * 0.38})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.len, 0, Math.PI * 2);
        ctx.fill();
      }

      // 出界回收
      if (p.y > h + 30) Object.assign(p, make(false));
      if (p.x < -60) p.x = w + 40;
      else if (p.x > w + 60) p.x = -40;
    }

    raf = requestAnimationFrame(frame);
  }

  function start() {
    if (raf || mode === 'off' || reduced) return;
    last = performance.now();
    raf = requestAnimationFrame(frame);
  }

  function stop() {
    cancelAnimationFrame(raf);
    raf = 0;
    ctx.clearRect(0, 0, w, h);
  }

  function setMode(next: Mode) {
    mode = next;
    localStorage.setItem(KEY, next);
    document.querySelectorAll<HTMLElement>('.wswitch button').forEach((b) => {
      b.classList.toggle('on', b.dataset.mode === next);
    });
    stop();
    if (next === 'off') return;
    spawn();
    start();
  }

  document.querySelectorAll<HTMLElement>('.wswitch button').forEach((b) => {
    b.addEventListener('click', () => setMode(b.dataset.mode as Mode));
  });

  // 标签页不可见时停掉，别空烧 CPU
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else start();
  });

  let rt: number;
  addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(resize, 150);
  });

  resize();
  setMode((localStorage.getItem(KEY) as Mode) ?? 'rain');
</script>

<style>
  #weather {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .wswitch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    display: flex;
    gap: 2px;
    padding: 3px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .wswitch button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.25rem 0.7rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: 0.15s;
  }
  .wswitch button:hover { color: var(--text); }
  .wswitch button.on { background: var(--text); color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    #weather { display: none; }
  }
</style>
