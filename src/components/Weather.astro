---
/* 背景天气：Canvas 2D 粒子，每次加载随机（无 / 雨 / 雪）
   近处雪花画六角形，远处画圆点；雨为斜线并随风偏移 */
---

<canvas id="weather" aria-hidden="true"></canvas>

<script>
  type Active = 'off' | 'rain' | 'snow';

  const canvas = document.getElementById('weather') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const active: Active = (['off', 'rain', 'snow'] as const)[Math.floor(Math.random() * 3)];

  let raf = 0;
  let w = 0, h = 0, dpr = 1;
  let wind = 0;
  let particles: Particle[] = [];

  interface Particle {
    x: number; y: number; z: number;
    v: number; len: number;
    phase: number; sway: number;
    rot: number; spin: number;
  }

  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth; h = innerHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (active !== 'off') spawn();
  }

  function count() {
    const area = w * h;
    return active === 'rain'
      ? Math.min(Math.round(area / 12000), 220)
      : Math.min(Math.round(area / 13000), 190);
  }

  function make(initial: boolean): Particle {
    const z = Math.random();
    return {
      x: Math.random() * w,
      y: initial ? Math.random() * h : -30 - Math.random() * 80,
      z,
      v: active === 'rain' ? 520 + z * 780 : 20 + z * 46,
      len: active === 'rain' ? 9 + z * 20 : 1.6 + z * 5.4,
      phase: Math.random() * Math.PI * 2,
      sway: 14 + Math.random() * 28,
      rot: Math.random() * Math.PI,
      spin: (Math.random() - 0.5) * 0.8,
    };
  }

  function spawn() {
    particles = Array.from({ length: count() }, () => make(true));
  }

  /** 六角雪花：主枝 + 两条小分枝 ×6 */
  function flake(x: number, y: number, r: number, rot: number, a: number, lw: number) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rot);
    ctx.strokeStyle = `rgba(116,142,180,${a})`;
    ctx.lineWidth = lw;
    ctx.lineCap = 'round';
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      ctx.rotate(Math.PI / 3);
      ctx.moveTo(0, 0); ctx.lineTo(0, -r);
      ctx.moveTo(0, -r * 0.58); ctx.lineTo(r * 0.3, -r * 0.84);
      ctx.moveTo(0, -r * 0.58); ctx.lineTo(-r * 0.3, -r * 0.84);
    }
    ctx.stroke();
    ctx.restore();
  }

  let last = performance.now();

  function frame(now: number) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;

    ctx.clearRect(0, 0, w, h);
    wind += dt * 0.12;
    const gust = Math.sin(wind) * (active === 'rain' ? 0.35 : 0.5);

    for (const p of particles) {
      if (active === 'rain') {
        const dx = gust * p.v * 0.22;
        p.x += dx * dt;
        p.y += p.v * dt;
        ctx.strokeStyle = `rgba(108,132,168,${0.12 + p.z * 0.3})`;
        ctx.lineWidth = 0.6 + p.z * 0.9;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(p.x - dx * 0.035, p.y + p.len);
        ctx.stroke();
      } else {
        p.phase += dt * 1.1;
        p.rot += p.spin * dt;
        p.x += (Math.sin(p.phase) * p.sway + gust * 26) * dt;
        p.y += p.v * dt;
        const a = 0.28 + p.z * 0.46;
        if (p.z > 0.5) {
          flake(p.x, p.y, p.len, p.rot, a, 0.7 + p.z * 0.7);
        } else {
          ctx.fillStyle = `rgba(126,150,188,${a})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.len * 0.55, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      if (p.y > h + 40) Object.assign(p, make(false));
      if (p.x < -60) p.x = w + 40;
      else if (p.x > w + 60) p.x = -40;
    }

    raf = requestAnimationFrame(frame);
  }

  function start() {
    if (raf || active === 'off' || reduced) return;
    last = performance.now();
    raf = requestAnimationFrame(frame);
  }
  function stop() { cancelAnimationFrame(raf); raf = 0; }

  // 标签页不可见时停掉，别空烧 CPU
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop(); else start();
  });

  let rt: number;
  addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(resize, 150); });

  resize();
  if (active !== 'off') { spawn(); start(); }
</script>

<style>
  #weather { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { #weather { display: none; } }
</style>
