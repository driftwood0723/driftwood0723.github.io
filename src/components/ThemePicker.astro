---
/* 临时组件：选定配色后删除本文件、themes.ts，并从 Base.astro 移除引用 */
import { themes } from '../themes';
---

<div class="picker" id="picker">
  <button class="toggle" id="picker-toggle" aria-expanded="false" title="切换配色">
    <span class="ring"></span>
  </button>

  <div class="panel" id="picker-panel" hidden>
    <p class="hd">试配色 <span>选定后告诉我，我写死并删掉这个面板</span></p>
    {
      themes.map((t) => (
        <button class="opt" data-theme={t.id}>
          <span class="dots">
            {t.swatch.map((c) => <i style={`background:${c}`} />)}
          </span>
          <span class="txt">
            <b>{t.name}</b>
            <em>{t.desc}</em>
          </span>
          <span class="tick">✓</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  import { themes } from '../themes';

  const KEY = 'theme-preview';
  const root = document.documentElement;
  const panel = document.getElementById('picker-panel')!;
  const toggle = document.getElementById('picker-toggle')!;

  // 切主题前先清掉上一套残留的变量，避免不同主题字段数不同时串色
  const allKeys = new Set(themes.flatMap((t) => Object.keys(t.vars)));

  function apply(id: string) {
    const theme = themes.find((t) => t.id === id);
    if (!theme) return;
    allKeys.forEach((k) => root.style.removeProperty(k));
    Object.entries(theme.vars).forEach(([k, v]) => root.style.setProperty(k, v));
    document.querySelectorAll<HTMLElement>('.opt').forEach((el) => {
      el.classList.toggle('on', el.dataset.theme === id);
    });
    localStorage.setItem(KEY, id);
  }

  document.querySelectorAll<HTMLElement>('.opt').forEach((el) => {
    el.addEventListener('click', () => apply(el.dataset.theme!));
  });

  toggle.addEventListener('click', () => {
    const open = panel.hasAttribute('hidden');
    panel.toggleAttribute('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('#picker')) {
      panel.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  apply(localStorage.getItem(KEY) ?? 'indigo');
</script>

<style>
  .picker { position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 90; }

  .toggle {
    width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
    display: grid; place-items: center;
    background: var(--surface-solid); box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
    transition: transform 0.2s var(--ease), border-color 0.2s;
  }
  .toggle:hover { transform: scale(1.07); border-color: var(--border-strong); }
  .ring {
    width: 20px; height: 20px; border-radius: 50%;
    background: conic-gradient(var(--accent), var(--accent-2), var(--accent-3), var(--accent));
  }

  .panel {
    position: absolute; right: 0; bottom: 56px; width: 288px;
    padding: 0.55rem; border-radius: 16px;
    background: var(--surface-solid);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    display: flex; flex-direction: column; gap: 0.15rem;
  }
  .panel[hidden] { display: none; }

  .hd {
    margin: 0.35rem 0.6rem 0.5rem; font-size: 0.78rem; color: var(--text-muted);
    display: flex; flex-direction: column;
  }
  .hd span { font-size: 0.68rem; color: var(--text-dim); }

  .opt {
    display: grid; grid-template-columns: auto 1fr auto; gap: 0.7rem;
    align-items: center; text-align: left; cursor: pointer;
    padding: 0.55rem 0.6rem; border-radius: 10px;
    background: transparent; border: 1px solid transparent; color: var(--text);
    transition: background 0.15s;
  }
  .opt:hover { background: var(--bg-soft); }
  .opt.on { background: var(--bg-soft); border-color: var(--border); }
  .opt.on .tick { opacity: 1; }

  .dots { display: flex; }
  .dots i {
    width: 13px; height: 13px; border-radius: 50%;
    border: 1.5px solid var(--surface-solid); margin-left: -5px;
  }
  .dots i:first-child { margin-left: 0; }

  .txt { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  .txt b { font-size: 0.85rem; font-weight: 550; }
  .txt em {
    font-style: normal; font-size: 0.7rem; color: var(--text-dim);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .tick { font-size: 0.75rem; color: var(--accent); opacity: 0; }
</style>
